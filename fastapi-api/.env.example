# Point this to the same DB used by the Node app
# If running docker-compose in this repo on the same host:
# DATABASE_URL=postgresql://rimun:rimunpass@127.0.0.1:5432/rimun?schema=public
# For FastAPI async engine we auto-upgrade to asyncpg scheme at runtime.
DATABASE_URL=postgresql://user:pass@host:5432/dbname?schema=public
